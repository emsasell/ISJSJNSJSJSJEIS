# Required for production persistence
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin panel password. Change this before deployment.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Vercel Blob token for photo/video uploads. Create a Blob store in Vercel.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# Optional: change cookie name if desired
ADMIN_COOKIE=megamine_admin
